# Backend — Zentro API
PORT=4000
FRONTEND_URL=http://localhost:3000
# URL pública de la API (los proveedores OAuth redirigen a {API_PUBLIC_URL}/api/v1/auth/oauth/{proveedor}/callback)
API_PUBLIC_URL=http://localhost:4000

# Inicio de sesión con Google (Google Cloud Console → Credenciales → ID de cliente OAuth "Aplicación web")
# URI de redirección autorizado: http://localhost:4000/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# [PAUSADO] Sign in with Apple (Apple Developer → Identifiers → Services IDs). Requiere Apple Developer Program.
# Apple exige HTTPS y un dominio real: registrar {API_PUBLIC_URL}/api/v1/auth/oauth/apple/callback
# (en local usar un túnel HTTPS, p. ej. ngrok, y ponerlo en API_PUBLIC_URL)
# APPLE_CLIENT_ID=
DATABASE_URL=postgresql://user:password@localhost:5432/zentro
# Base temporal para `prisma migrate dev` / `migrate diff` (debe existir y estar vacía)
SHADOW_DATABASE_URL=postgresql://user:password@localhost:5432/zentro_shadow
JWT_SECRET=your-secret-key-change-in-production
# Clave para cifrar los secretos de 2FA (texto largo aleatorio). Obligatoria en producción.
TWO_FACTOR_KEY=change-me-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

# Email (forgot password)
# MAIL_DRIVER: "log" imprime el código en consola (dev) | "resend" envía correo real
MAIL_DRIVER=log
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
MAIL_FROM_NAME=Zentro
MAIL_FROM_EMAIL=onboarding@resend.dev
# Destino de los mensajes del formulario de contacto
MAIL_CONTACT_TO=usezentroapp@gmail.com

# Código de recuperación de contraseña
RESET_CODE_TTL_MINUTES=15
RESET_CODE_MAX_ATTEMPTS=5
